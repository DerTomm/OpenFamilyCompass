<?xml version="1.0" encoding="utf-8"?>
<!-- Monochrome notification icon: bold compass needle (white on transparent).
     Kept intentionally simple for clarity at small sizes (24dp). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- North half of compass needle (pointing up, bold triangle) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2 L16,12 L12,10 L8,12 Z" />

    <!-- South half of compass needle (pointing down, bold triangle) -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M12,22 L16,12 L12,14 L8,12 Z" />

</vector>