# Android Keystore Configuration
# Copy this file to keystore.properties and fill in your actual values
# DO NOT commit keystore.properties to version control!

# Path to your release keystore file
# Example: ../my-release-key.keystore or /absolute/path/to/keystore
RELEASE_STORE_FILE=path/to/your/release.keystore

# Keystore password
RELEASE_STORE_PASSWORD=your_keystore_password

# Key alias
RELEASE_KEY_ALIAS=your_key_alias

# Key password
RELEASE_KEY_PASSWORD=your_key_password
