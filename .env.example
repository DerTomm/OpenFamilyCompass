# OpenFamilyCompass Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=openfamilycompass_db
POSTGRES_USER=openfamilycompass_user
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_PORT=5432

# ============================================
# Backend Configuration
# ============================================
BACKEND_PORT=8080

# Admin User (First-time setup)
APP_ADMIN_DEFAULT_USERNAME=admin
APP_ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here

# JWT Keys (optional, leave empty if using default)
JWT_KEYSTORE_PASSWORD=

# CORS - Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19000,http://localhost:19001

# ============================================
# Frontend Configuration (Expo Go)
# ============================================
METRO_PORT=8081
EXPO_PORT=19000
EXPO_PORT2=19001

# Hostname für Expo Dev Server (setze auf deine Server-IP für Remote-Zugriff)
EXPO_HOST=localhost

# Backend API URL (used by Expo app at runtime)
EXPO_PUBLIC_API_URL=http://localhost:8080
