# OpenFamilyCompass Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=openfamilycompass_db
POSTGRES_USER=openfamilycompass_user
POSTGRES_PASSWORD=your_secure_database_password_here
POSTGRES_PORT=5432

# ============================================
# Backend Configuration
# ============================================
BACKEND_PORT=8080

# Admin User (First-time setup)
APP_ADMIN_DEFAULT_USERNAME=admin
APP_ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here

# JWT Keystore Password - must be a strong, unique value in production.
# Leave empty to fall back to the (insecure) default "changeit"; the app will
# refuse to start in that case unless APP_SECURITY_FAIL_ON_DEFAULT_CREDENTIALS
# is explicitly set to false (see below).
JWT_KEYSTORE_PASSWORD=

# Fail-fast on default/weak credentials. The app ships with this check ON.
# Set to "false" ONLY for local dev when you intentionally run with the
# default admin password and default JWT keystore password. NEVER disable
# this in production deployments.
APP_SECURITY_FAIL_ON_DEFAULT_CREDENTIALS=true

# CORS - Allowed Origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19000,http://localhost:19001

# ============================================
# Frontend Configuration (Expo Go)
# ============================================
METRO_PORT=8081
EXPO_PORT=19000
EXPO_PORT2=19001

# Hostname für Expo Dev Server (setze auf deine Server-IP für Remote-Zugriff)
EXPO_HOST=localhost

# Backend API URL (used by Expo app at runtime)
EXPO_PUBLIC_API_URL=http://localhost:8080
