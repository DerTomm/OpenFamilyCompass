# OpenFamilyCompass Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control!

# ============================================
# Database Configuration
# ============================================
POSTGRES_DB=openfamilycompass_db
POSTGRES_USER=openfamilycompass_user
POSTGRES_PASSWORD=your_secure_database_password_here

# ============================================
# Spring Datasource
# ============================================
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/openfamilycompass_db
SPRING_DATASOURCE_USERNAME=openfamilycompass_user
SPRING_DATASOURCE_PASSWORD=your_secure_database_password_here

# ============================================
# OAuth2 Configuration
# ============================================
# Generate a strong random secret for production
# Example: openssl rand -base64 32
SPRING_SECURITY_OAUTH2_CLIENT_SECRET=your_secure_oauth_secret_here

# ============================================
# Admin User Configuration
# ============================================
# Default admin credentials for first-time setup
# Change the password immediately after first login!
APP_ADMIN_DEFAULT_USERNAME=admin
APP_ADMIN_DEFAULT_PASSWORD=your_secure_admin_password_here

# ============================================
# Server Configuration (Optional)
# ============================================
# SERVER_PORT=8080
